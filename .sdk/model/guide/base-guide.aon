# Guide

guide: {
  metrics: count: entity: 3
  metrics: count: path: 6
  metrics: count: method: 6

  entity: comparison: {
    path: "/comparison": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: discovery: {
    path: "/expressions": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
  }

  entity: wealth_expression: {
    path: "/durationOfDailySpend": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/growthOfCompoundInterest": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/heightOfMoneyStack": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/numberOfItems": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

}